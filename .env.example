# Copie este archivo como .env y ajústelo. NO contiene credenciales: los secretos que no se
# definan aquí se generan automáticamente en var/keys/secrets.json (solo desarrollo).

# --- LLM (API compatible con OpenAI) ---
LLM_PROVIDER=ollama                 # ollama | openai | mock (mock = solo pruebas)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma4:31b-cloud
LLM_API_KEY=ollama                  # Ollama ignora la clave; para otro proveedor ponga la suya aquí, nunca en git
LLM_TIMEOUT=120

# Precio de referencia para estimar costo (USD por millón de tokens). 0 con modelo local.
PRICE_IN_PER_MTOK=0
PRICE_OUT_PER_MTOK=0

# --- RAG ---
EMBED_PROVIDER=hashing              # hashing (local, sin descargas) | ollama
EMBED_MODEL=nomic-embed-text
OLLAMA_URL=http://localhost:11434

# --- Servicios ---
MCP_URL=http://127.0.0.1:8100/mcp
FACE_SERVICE_URL=http://127.0.0.1:8200
FACE_PUBLIC_URL=http://127.0.0.1:8200
FACE_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
FACE_ENGINE=opencv                  # opencv | simulated (solo pruebas automáticas)
FACE_YAW_SIGN=1                     # ponga -1 si su cámara entrega la imagen espejada
DEMO_MODE=true                      # habilita el panel de fallos y el estado de la BD

# --- Secretos (opcional; si se omiten se generan localmente) ---
# AUDIT_HMAC_KEY=
# MCP_SHARED_SECRET=
# ENROLL_TICKET_SECRET=
# FACE_SERVICE_KEY=
# FACE_TEMPLATE_KEY=                # clave Fernet (base64 urlsafe de 32 bytes)

# --- Reloj del dominio (opcional, para reproducir escenarios) ---
# LABBOT_NOW=2026-11-02T09:00
